meta {
  name: Get Point
  type: http
  seq: 5
}

get {
  url: {{base_url}}/api/point/{{point_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{auth_token}}
}

vars:pre-request {
  point_id: 7818fcad-93e1-447d-8218-9a335833d880
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  
  test("data object exists", function() {
    expect(res.body.data).to.be.an("object");
  });
  
  test("id is returned", function() {
    expect(res.body.data.id).to.be.a("string").and.to.have.length.greaterThan(0);
  });
  
  test("lat/lon are numbers", function() {
    expect(res.body.data.lat).to.be.a("number");
    expect(res.body.data.lon).to.be.a("number");
  });
  
  test("elevation is a number", function() {
    expect(res.body.data.elevation).to.be.a("number");
  });
  
  test("user email is returned", function() {
    expect(res.body.data.user).to.be.a("string");
  });
  
  test("category_id is a number", function() {
    expect(res.body.data.category_id).to.be.a("number");
  });
}
