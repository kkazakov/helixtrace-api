meta {
  name: List Points
  type: http
  seq: 4
}

get {
  url: {{base_url}}/api/points?include_public=true&include_meshcore_dashboard=true
  body: none
  auth: bearer
}

params:query {
  include_public: true
  include_meshcore_dashboard: true
}

auth:bearer {
  token: {{auth_token}}
}

tests {
  test("status 200", function() {
    expect(res.status).to.equal(200);
  });
  
  test("response is array", function() {
    expect(res.body).to.be.an("array");
  });
}
