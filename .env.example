# Helixtrace API Configuration

# OpenTopoData server, change to your server!!!
OPENTOPADATA_SERVER=https://api.opentopodata.org/v1/test-dataset
OPENTOPADATA_MAX_LOCATIONS=100

# Trace Path
TRACE_PATH_POINT_DISTANCE=50

# ClickHouse Database
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=9000
CLICKHOUSE_DATABASE=helixtrace
CLICKHOUSE_USER=admin
CLICKHOUSE_PASSWORD=

# API Server
API_HOST=0.0.0.0
API_PORT=8000



# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Meshcore Dashboard API (optional - for external repeater points)
MESHCORE_DASHBOARD_API=

# Photon geocode server
PHOTON_SERVER=https://photon.komoot.io
GEOCODE_CACHE_TTL_MINUTES=60
GEOCODE_MAX_RESULTS=50
SEARCH_IN_POINTS=false

# Enable debug logging (true/false)
DEBUG=false
